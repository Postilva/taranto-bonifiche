 inerte, Realizzazione di un sistema di umidificazione del suolo per favorire il processo di mineralizzazione delle salme, Posa in opera di pavimentazione monolitica con idonea pendenza per lo smaltimento delle acque piovane, Realizzazione ex-novo di un tratto di fognatura a servizio dei campi di inumazione","oc_stato_finanziario":"In corso","oc_stato_procedurale":"In esecuzione","oc_stato_progetto":"In corso","oc_tema_sintetico":"Ambiente","oc_titolo_progetto":"Bonifica aree non pavimentate Cimitero San Brunone","oc_tot_pagamenti_beneficiari":"21417,72","oc_tot_pagamenti_trasferimenti":"0,00","tot_pagamenti":"21417,72","programmi":[{"codice_programma":"PSCTRANSECOLOG","cod_ambito_snai":"","cod_area_snai":"","cod_area_tematica_psc":"05","cod_asse_tematico_fsc":"","cod_asse_tematico_pac":"","cod_azione":"","cod_campo_intervento":"","cod_categ_regione":"","cod_focus_area":"","cod_linea":"","cod_linea_azione_pac":"","cod_macroarea_psc":"M","cod_misura":"","cod_obiettivo_specifico":"","cod_ob_tematico":"06","cod_priorita":"","cod_priorita_invest":"","cod_proced_attivazione":"PRATT21717","cod_risultato_atteso":"06.2","cod_settore_strategico_fsc":"","cod_sett_interv_psc":"04","cod_sezione_psc":"SO","cod_sottomisura":"","cod_strumento":"POFSCSTA23","cod_tipo_intervento":"","cod_tipo_proced_attivazione":"5","costo_rendicontabile_ue":"","data_approv_strumento":"","data_effettiva_bando_proc_attiv":"","data_effettiva_fine_proc_attiv":"","data_effettiva_inizio_proc_attiv":"20180328","data_prevista_bando_proc_attiv":"","data_prevista_fine_proc_attiv":"","descr_ambito_snai":"","descr_area_snai":"","descr_area_tematica_psc":"Ambiente e risorse naturali","descr_asse_tematico_fsc":"","descr_asse_tematico_pac":"","descr_azione":"","descr_campo_intervento":"","descr_categ_regione":"","descr_focus_area":"","descr_linea":"","descr_linea_azione_pac":"","descr_macroarea_psc":"Mezzogiorno","descr_misura":"","descr_obiettivo_specifico":"","descr_ob_tematico":"Tutelare l'ambiente e promuover